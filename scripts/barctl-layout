#!/bin/bash
# Bar layout inspection and reordering for Bar Control, on top of the stock
# `omarchy bar move` plumbing (persist + live nudge).
# usage: barctl-layout list | move <widget-id> <up|down|left|right>
# list prints "section|index|id" per entry, sections in bar order.
set -uo pipefail

SHELL_JSON=${OMARCHY_SHELL_JSON:-$HOME/.config/omarchy/shell.json}
# Bar Control writes a one-shot "reopen the panel after the bar rebuilds"
# state before every move: the layout change rebuilds bar widgets, which
# destroys the panel; the next widget instance consumes this and reopens it.
STATE=${OMARCHY_BAR_CONTROL_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/bar-control}
REOPEN=$STATE/reopen
CANON="left centerBegin center centerEnd right tray"

sections() {
  jq -r '.bar.layout | to_entries | map(select(.value | type == "array")) | map(.key) | join(" ")' "$SHELL_JSON"
}

list() {
  jq -r '.bar.layout | to_entries[] | .key as $s |
    (select(.value | type == "array") | .value | to_entries[]) |
    "\($s)|\(.key)|\(.value.id // "")|\(.value.color // "")"' "$SHELL_JSON"
}

locate() { # id -> "section index" or ""
  list | awk -F'|' -v id="$1" '$3 == id { print $1, $2; found=1 } END { if (!found) exit 1 }'
}

neighbor_section() { # current direction -> adjacent existing section
  local cur=$1 dir=$2 all s last= prev= next=
  all=$(sections)
  for s in $CANON; do
    case $all in *$s*) ;; *) continue ;; esac
    if [[ $s == "$cur" ]]; then
      prev=$last
    else
      if [[ -n $cur && $last == "$cur" ]]; then next=$s; break; fi
    fi
    last=$s
  done
  [[ $dir == left ]] && echo "${prev:-}" || echo "${next:-}"
}

case ${1:-} in
  list)
    list
    ;;
  keep)
    mkdir -p "$STATE" && printf '%s\n%s\n' "${2:-layout}" "$(date +%s)" > "$REOPEN"
    ;;
  move)
    id=${2:-}; dir=${3:-}; keep_tab=${4:-layout}
    loc=$(locate "$id") || { echo "not found: $id" >&2; exit 1; }
    sec=${loc% *}; idx=${loc#* }
    count=$(awk -F'|' -v s="$sec" '$1 == s' <<<"$(list)" | wc -l)
    case $dir in
      up) (( idx > 0 )) || exit 0; (( idx-- )) ;;
      down) (( idx < count - 1 )) || exit 0; (( idx++ )) ;;
      left|right)
        tgt=$(neighbor_section "$sec" "$dir")
        [[ -n $tgt ]] || exit 0
        sec=$tgt
        idx=$(awk -F'|' -v s="$sec" '$1 == s' <<<"$(list)" | wc -l)
        ;;
      *) exit 1 ;;
    esac
    mkdir -p "$STATE" && printf '%s\n%s\n' "$keep_tab" "$(date +%s)" > "$REOPEN"
    omarchy bar move "$id" --section "$sec" --index "$idx" >/dev/null 2>&1 || { rm -f "$REOPEN"; exit 1; }
    list
    ;;
  color)
    id=${2:-}; hex=${3:-}
    [[ -n $id ]] || exit 1
    if [[ $hex == "-" ]]; then
      expr='del(.color)'
    else
      [[ $hex =~ ^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$ ]] || exit 1
      expr='.color = $hex'
    fi
    # A color write on a custom module forces a full bar rebuild (inline
    # settings push can't reach it), so leave the same reopen note as a move.
    mkdir -p "$STATE" && printf '%s\n%s\n' layout "$(date +%s)" > "$REOPEN"
    tmp=$(mktemp)
    if jq --arg id "$id" --arg hex "$hex" "
          .bar.layout |= with_entries(
            if (.value | type) == \"array\" then
              .value |= map(if (.id // \"\") == \$id then $expr else . end)
            else . end)" "$SHELL_JSON" > "$tmp"; then
      mv "$tmp" "$SHELL_JSON"
    else
      rm -f "$tmp"; exit 1
    fi
    ;;
  take)
    if [[ -f $REOPEN ]]; then cat "$REOPEN"; rm -f "$REOPEN"; fi
    ;;
  *) echo "usage: barctl-layout list | move <id> <up|down|left|right> [tab] | color <id> <#hex|-> | keep [tab] | take" >&2; exit 1 ;;
esac
